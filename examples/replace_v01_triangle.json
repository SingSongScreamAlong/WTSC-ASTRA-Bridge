{
  "id": "example-replace-v01-triangle",
  "op": "batch.execute",
  "args": {
    "commands": [
      {"op": "object.delete", "args": {"name": "TRIANGLE_LEFT"}},
      {"op": "object.delete", "args": {"name": "TRIANGLE_RIGHT"}},
